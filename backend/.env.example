# Copy to .env for local development. Never commit .env.
ENVIRONMENT=development

DATABASE_URL=postgresql+psycopg://localhost:5432/clothing_store
TEST_DATABASE_URL=postgresql+psycopg://localhost:5432/clothing_store_test

# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me-insecure-development-only-secret-value
JWT_EXPIRES_MINUTES=720

# Comma-separated; production must list only the real storefront/admin origin(s).
CORS_ORIGINS=http://localhost:4200

LOGIN_RATE_LIMIT_PER_MINUTE=10
ORDER_RATE_LIMIT_PER_MINUTE=10

# Delivery outside the free zone: base fee + fee per started block of km from central Doha.
DELIVERY_OUTSIDE_BASE_FEE=10.00
DELIVERY_FEE_PER_STEP=1.00
DELIVERY_STEP_KM=5
# FREE_DELIVERY_THRESHOLD=200.00
LOW_STOCK_THRESHOLD=3
MAX_QUANTITY_PER_LINE=10

# Invoice header details — confirm against the registered business before launch.
BUSINESS_NAME=Brand Name
BUSINESS_PHONE=
BUSINESS_EMAIL=
BUSINESS_ADDRESS=Doha, Qatar
BUSINESS_REGISTRATION=

# Public storefront URL, used in the sitemap.
SITE_URL=http://localhost:4200
# Optional: Sentry DSN for error reporting (leave empty to disable).
SENTRY_DSN=
